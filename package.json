{
  "name": "homebridge-itach-garage-door",
  "version": "1.0.0",
  "displayName": "iTach IP2CC Garage Door & Gates",
  "description": "Homebridge plugin that controls garage doors and gates through a Global Caché iTach IP2CC contact-closure relay over TCP. Drives a momentary pulse like a wall button, infers door position from configurable travel timers, and accepts authenticated webhook updates so an external sensor can correct the reported state.",
  "license": "MIT",
  "author": {
    "name": "Rich Dawson",
    "url": "https://github.com/rdawson6"
  },
  "contributors": [
    {
      "name": "Kiro AI",
      "url": "https://kiro.dev"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rdawson6/homebridge-itach-garage-door"
  },
  "homepage": "https://github.com/rdawson6/homebridge-itach-garage-door#readme",
  "bugs": {
    "url": "https://github.com/rdawson6/homebridge-itach-garage-door/issues"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist",
    "lint": "eslint src/ --ext .ts",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "garage-door",
    "itach",
    "ip2cc",
    "global-cache"
  ],
  "engines": {
    "node": ">=20.0.0",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint": "^8.57.0",
    "fast-check": "^3.19.0",
    "homebridge": "^1.8.4",
    "typescript": "^5.4.5",
    "vitest": "^2.0.5"
  },
  "files": [
    "dist/",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md"
  ]
}
